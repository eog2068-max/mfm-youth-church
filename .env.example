# ============================================================
# Supabase (Stage 3 — required for Go-A-Fishing)
# ============================================================
# From Supabase dashboard → Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# From Supabase dashboard → Project Settings → Database → Connection string
# Use the POOLED connection (port 6543) for Vercel serverless.
# Format: postgresql://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_postgresql_connection_string

# ============================================================
# Go-A-Fishing (Stage 3 — referral link attribution)
# ============================================================
# Base URL used when generating referral links / QR codes.
# Should be the public production URL (no trailing slash).
NEXT_PUBLIC_GAF_BASE_URL=https://rccg-rehoboth.app

# Optional overrides (defaults shown):
# GAF_ATTRIBUTION_COOKIE_NAME=gaf_referrer
# GAF_ATTRIBUTION_WINDOW_DAYS=30

# ============================================================
# Legacy (will be removed in post-Stage-12 cleanup)
# ============================================================
# next-auth@4.24.11 is currently a dead dependency (never imported).
# These env vars are unused but kept for now to avoid breaking anything.
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# ============================================================
# Existing social features (preserved per Stage 1 audit)
# ============================================================
# Admin key for /api/social/admin* endpoints (already in use):
# SOCIAL_ADMIN_KEY=set-this-in-vercel

# ============================================================
# Supabase (required for Go-A-Fishing)
# ============================================================
# From Supabase dashboard → Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# From Supabase dashboard → Project Settings → Database → Connection string
# Use the POOLED connection (port 6543) for Vercel serverless.
# Format: postgresql://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_postgresql_connection_string

# ============================================================
# Go-A-Fishing Configuration
# ============================================================
# Base URL used when generating referral links / QR codes.
# Should be the public production URL (no trailing slash).
NEXT_PUBLIC_GAF_BASE_URL=https://www.mfmannexyouth.org

# Optional overrides (defaults shown):
# GAF_ATTRIBUTION_COOKIE_NAME=gaf_referrer
# GAF_ATTRIBUTION_WINDOW_DAYS=30
# GAF_SCORING_WEIGHTS_JSON={"invited":1,"attended":5,"saved":10,"baptized":25,"member":50}

# ============================================================
# Existing Social Features (preserved per Stage 1 audit)
# ============================================================
# Admin key for /api/social/admin* endpoints (already in use):
# SOCIAL_ADMIN_KEY=set-this-in-vercel
